# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/i3d_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=INFO

# ========== RAG Configuration ==========
# RAG Storage
RAG_DATA_PATH=./data/rag
RAG_DOCUMENTS_PATH=./data/rag/documents

# RAG Chunking
CHUNK_SIZE_DEFAULT=800
CHUNK_OVERLAP_DEFAULT=150

# RAG Retrieval
RAG_TOP_K_RESULTS=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_RERANK_TOP_K=5

# RAG Hybrid Weights
HYBRID_ALPHA_SEMANTIC=0.7
HYBRID_ALPHA_KEYWORD=0.3
HYBRID_ALPHA_EXACT=0.1

# RAG Agentic
AGENTIC_QUERY_EXPANSION_COUNT=3
AGENTIC_MAX_ITERATIONS=3
AGENTIC_ENABLE_HYDE=true
AGENTIC_ENABLE_RERANK=true

# RAG Rerank
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-english-v2.0
COHERE_API_KEY=your-cohere-api-key

# RAG Index
INDEX_BATCH_SIZE=10
INDEX_WORKER_CONCURRENCY=2
